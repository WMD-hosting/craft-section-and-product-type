{
    "name": "wmd/section-and-product-type",
    "description": "Craft CMS field types for selecting sections, entry types and Commerce product types. Built for page builders and dynamic content listings.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "craft6",
        "field",
        "field-type",
        "section",
        "entry type",
        "product type",
        "commerce",
        "page builder"
    ],
    "support": {
        "docs": "https://github.com/WMD-hosting/craft-section-and-product-type/blob/3.x/README.md",
        "issues": "https://github.com/WMD-hosting/craft-section-and-product-type/issues"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "WMD Hosting",
            "homepage": "https://wmd.hosting/"
        }
    ],
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-beta.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "wmd\\sectionandproducttype\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "wmd\\sectionandproducttype\\tests\\": "tests/",
            "CraftCms\\Cms\\Database\\Factories\\": "vendor/craftcms/cms/database/Factories/"
        }
    },
    "extra": {
        "name": "Section + Entry type + Product Type",
        "handle": "section-and-product-type",
        "developer": "WMD Hosting",
        "developerUrl": "https://wmd.hosting/",
        "documentationUrl": "https://github.com/WMD-hosting/craft-section-and-product-type/blob/3.x/README.md",
        "changelogUrl": "https://raw.githubusercontent.com/WMD-hosting/craft-section-and-product-type/3.x/CHANGELOG.md",
        "class": "wmd\\sectionandproducttype\\SectionAndProductType"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "craftcms/plugin-installer": true,
            "yiisoft/yii2-composer": false
        }
    }
}
