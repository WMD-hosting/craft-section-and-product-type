{# Shared author-facing input. `value` is an ID list (multiple) or a single ID / ''.
   `options` is null when there is nothing to pick from; `notice` then says why. #}
{% import '_includes/forms' as forms %}

{% if notice %}
    <p class="light">{{ notice }}</p>
{% endif %}

{% if options is not null %}
    {% if field.multiple %}
        {% if dropdown %}
            {{ forms.multiselect({
                id: field.handle,
                name: field.handle,
                values: value,
                options: options,
            }) }}
        {% else %}
            {{ forms.checkboxGroup({
                id: field.handle,
                name: field.handle,
                values: value,
                options: options,
            }) }}
        {% endif %}
    {% else %}
        {% if dropdown %}
            {{ forms.select({
                id: field.handle,
                name: field.handle,
                value: value,
                options: options,
            }) }}
        {% else %}
            {{ forms.radioGroup({
                id: field.handle,
                name: field.handle,
                value: value,
                options: options,
            }) }}
        {% endif %}
    {% endif %}
{% endif %}
