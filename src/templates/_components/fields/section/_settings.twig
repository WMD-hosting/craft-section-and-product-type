{% import '_includes/forms' as forms %}

{% set allowSections = selectAll ? [true] : field.allowedSections %}
{% set filterId = "optionFilter#{random()}" %}
{% set optionListsId = "optionLists#{random()}" %}

{{ forms.checkboxField({
    label : 'Multiple Select' | t('section-and-product-type'),
    instructions : 'If checked, the user can select multiple sections, otherwise they can only select one.' | t('section-and-product-type'),
    name : 'multiple',
    checked: field.multiple
}) }}

<hr>

{{ forms.selectField({
    label : 'View Mode' | t('section-and-product-type'),
    instructions : 'How the sections are presented when editing an entry. Choose Dropdown when there are a lot of sections to pick from.' | t('section-and-product-type'),
    id : 'viewMode',
    name : 'viewMode',
    value: field.viewMode,
    options : viewModes
}) }}

<hr>

{{ forms.selectField({
    label : 'Template Value' | t('section-and-product-type'),
    instructions : 'What the field hands back in templates. IDs returns the selected sections IDs, which is what this plugin has always done. Objects returns an object whose all(), ids(), handles() and names() methods give you the sections themselves.' | t('section-and-product-type'),
    id : 'valueType',
    name : 'valueType',
    value: field.valueType,
    options : valueTypes
}) }}

<hr>

{{ forms.checkboxField({
    label : 'Select All Sections' | t('section-and-product-type'),
    instructions : 'This will allow all sections to be used for selection.' | t('section-and-product-type'),
    name : 'selectAll',
    checked: field.selectAll
}) }}

<hr>

{{ forms.textField({
    id: 'partOfHandle',
    label : 'Select Section By Text In Handle' | t('section-and-product-type'),
    instructions : 'This will allow to select all section by text in handle.' | t('section-and-product-type'),
    name : 'partOfHandle',
    value: partOfHandle,
}) }}

<hr>

{{ forms.textField({
    id: filterId,
    label : 'Filter The Lists Below' | t('section-and-product-type'),
    instructions : 'Narrows the two lists below to the sections whose name or handle contains this text. It only changes what is shown, it is not saved with the field.' | t('section-and-product-type'),
    placeholder: 'Search sections' | t('section-and-product-type'),
}) }}

<div id="{{ optionListsId }}">
    {{ forms.checkboxGroupField({
        label : 'Allowed Sections' | t('section-and-product-type'),
        instructions : 'The sections that may be chosen for this field.\n **If selected Select All Sections, all sections are selected**.' | t('section-and-product-type'),
        name : 'allowedSections',
        values: allowSections,
        options : sectionOptions
    }) }}

    <hr>

    {{ forms.checkboxGroupField({
        label : 'Exclude Sections' | t('section-and-product-type'),
        instructions : 'The sections that will be excluded from the selection for this field.\n **Used when select all is on**.' | t('section-and-product-type'),
        options : sectionOptions,
        values: field.excludedSections,
        id : 'excludedSections',
        name : 'excludedSections',
    }) }}
</div>

{% js %}
new Craft.SectionAndProductType.OptionFilter('#{{ filterId|namespaceInputId|e('js') }}', '#{{ optionListsId|namespaceInputId|e('js') }}');
{% endjs %}
