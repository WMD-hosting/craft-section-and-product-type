{% import '_includes/forms' as forms %}

{% set allowEntryTypes = selectAll ? [true] : field.allowedEntryTypes %}
{% set filterId = "optionFilter#{random()}" %}
{% set optionListsId = "optionLists#{random()}" %}

{{ forms.checkboxField({
    label : 'Multiple Select' | t('section-and-product-type'),
    instructions : 'If checked, the user can select multiple entry types, otherwise they can only select one.' | t('section-and-product-type'),
    name : 'multiple',
    checked: field.multiple
}) }}

<hr>

{{ forms.selectField({
    label : 'View Mode' | t('section-and-product-type'),
    instructions : 'How the entry types are presented when editing an entry. Choose Dropdown when there are a lot of entry types to pick from.' | t('section-and-product-type'),
    id : 'viewMode',
    name : 'viewMode',
    value: field.viewMode,
    options : viewModes
}) }}

<hr>

{{ forms.selectField({
    label : 'Template Value' | t('section-and-product-type'),
    instructions : 'What the field hands back in templates. IDs returns the selected entry type IDs. Objects returns an object whose all(), ids(), handles() and names() methods give you the entry types themselves.' | t('section-and-product-type'),
    id : 'valueType',
    name : 'valueType',
    value: field.valueType,
    options : valueTypes
}) }}

<hr>

{{ forms.checkboxField({
    label : 'Select All Entry Types' | t('section-and-product-type'),
    instructions : 'This will allow all entry types to be used for selection.' | t('section-and-product-type'),
    name : 'selectAll',
    checked: field.selectAll
}) }}

<hr>

{{ forms.textField({
    id: 'partOfHandle',
    label : 'Select Entry Type By Text In Handle' | t('section-and-product-type'),
    instructions : 'This will allow to select all entry types by text in handle.' | t('section-and-product-type'),
    name : 'partOfHandle',
    value: partOfHandle,
}) }}

<hr>

{{ forms.textField({
    id: filterId,
    label : 'Filter The Lists Below' | t('section-and-product-type'),
    instructions : 'Narrows the two lists below to the entry types whose name or handle contains this text. It only changes what is shown, it is not saved with the field.' | t('section-and-product-type'),
    placeholder: 'Search entry types' | t('section-and-product-type'),
}) }}

<div id="{{ optionListsId }}">
    {{ forms.checkboxGroupField({
        label : 'Allowed Entry Types' | t('section-and-product-type'),
        instructions : 'The entry types that may be chosen for this field.\n **If selected Select All Entry Types, all entry types are selected**.' | t('section-and-product-type'),
        name : 'allowedEntryTypes',
        values: allowEntryTypes,
        options : entryTypeOptions
    }) }}

    <hr>

    {{ forms.checkboxGroupField({
        label : 'Exclude Entry Types' | t('section-and-product-type'),
        instructions : 'The entry types that will be excluded from the selection for this field.\n **Used when select all is on**.' | t('section-and-product-type'),
        options : entryTypeOptions,
        values: field.excludedEntryTypes,
        id : 'excludedEntryTypes',
        name : 'excludedEntryTypes',
    }) }}
</div>

{% js %}
new Craft.SectionAndProductType.OptionFilter('#{{ filterId|namespaceInputId|e('js') }}', '#{{ optionListsId|namespaceInputId|e('js') }}');
{% endjs %}
