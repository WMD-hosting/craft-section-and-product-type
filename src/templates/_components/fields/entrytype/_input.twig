{% import '_includes/forms' as forms %}

{% if field.multiple %}
        {% if dropdown %}
                {{ forms.multiselect({
                        id : field.handle,
                        name : field.handle,
                        values: value,
                        options: entryTypes
                }) }}
        {% else %}
                {{ forms.checkboxGroup({
                        id : field.handle,
                        name : field.handle,
                        values: value,
                        options: entryTypes
                }) }}
        {% endif %}
{% else %}
        {% if dropdown %}
                {{ forms.select({
                        id : field.handle,
                        name : field.handle,
                        value: value,
                        options: entryTypes
                }) }}
        {% else %}
                {{ forms.radioGroup({
                        id : field.handle,
                        name : field.handle,
                        value: value,
                        options: entryTypes
                }) }}
        {% endif %}
        {% if value is iterable %}
                <p class="warning">{{ "Multiple entry types selected but only one can be selected in the field." | t('section-and-product-type') }}</p>
        {% endif %}
{% endif %}
