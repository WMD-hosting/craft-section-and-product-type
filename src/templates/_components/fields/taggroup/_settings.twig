{% import '_includes/forms' as forms %}

{% set allowTagGroups = selectAll ? [true] : field.allowedGroups %}
{% set filterId = "optionFilter#{random()}" %}
{% set optionListsId = "optionLists#{random()}" %}

{{ forms.checkboxField({
    label : 'Multiple Select' | t('section-and-product-type'),
    instructions : 'If checked, the user can select multiple tag groups, otherwise they can only select one.' | t('section-and-product-type'),
    name : 'multiple',
    checked: field.multiple
}) }}

<hr>

{{ forms.selectField({
    label : 'View Mode' | t('section-and-product-type'),
    instructions : 'How the tag groups are presented when editing an entry. Choose Dropdown when there are a lot of tag groups to pick from.' | t('section-and-product-type'),
    id : 'viewMode',
    name : 'viewMode',
    value: field.viewMode,
    options : viewModes
}) }}

<hr>

{{ forms.selectField({
    label : 'Template Value' | t('section-and-product-type'),
    instructions : 'What the field hands back in templates. IDs returns the selected tag groups IDs, which is what this plugin has always done. Objects returns an object whose all(), ids(), handles() and names() methods give you the tag groups themselves.' | t('section-and-product-type'),
    id : 'valueType',
    name : 'valueType',
    value: field.valueType,
    options : valueTypes
}) }}

<hr>

{{ forms.checkboxField({
    label : 'Select All Tag Groups' | t('section-and-product-type'),
    instructions : 'This will allow all tag groups to be used for selection.' | t('section-and-product-type'),
    name : 'selectAll',
    checked: field.selectAll
}) }}

<hr>

{{ forms.textField({
    id: 'partOfHandle',
    label : 'Select Tag Group By Text In Handle' | t('section-and-product-type'),
    instructions : 'This will allow to select all tag groups by text in handle.' | t('section-and-product-type'),
    name : 'partOfHandle',
    value: partOfHandle,
}) }}

<hr>

{{ forms.textField({
    id: filterId,
    label : 'Filter The Lists Below' | t('section-and-product-type'),
    instructions : 'Narrows the two lists below to the tag groups whose name or handle contains this text. It only changes what is shown, it is not saved with the field.' | t('section-and-product-type'),
    placeholder: 'Search tag groups' | t('section-and-product-type'),
}) }}

<div id="{{ optionListsId }}">
    {{ forms.checkboxGroupField({
        label : 'Allowed Tag Groups' | t('section-and-product-type'),
        instructions : 'The groups that may be chosen for this field.\n **If selected Select All Tag Groups, all sections are selected**.' | t('section-and-product-type'),
        name : 'allowedGroups',
        values: allowTagGroups,
        options : groupOptions
    }) }}

    <hr>

    {{ forms.checkboxGroupField({
        label : 'Exclude Groups' | t('section-and-product-type'),
        instructions : 'The groups that will be excluded from the selection for this field.\n **Used when select all is on**.' | t('section-and-product-type'),
        options : groupOptions,
        values: field.excludedGroups,
        id : 'excludedGroups',
        name : 'excludedGroups',
    }) }}
</div>

{% js %}
new Craft.SectionAndProductType.OptionFilter('#{{ filterId|namespaceInputId|e('js') }}', '#{{ optionListsId|namespaceInputId|e('js') }}');
{% endjs %}
