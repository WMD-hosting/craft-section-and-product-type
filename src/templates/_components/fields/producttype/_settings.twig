{% import '_includes/forms' as forms %}

{% set allowProductTypes = selectAll ? [true] : field.allowProductTypes %}
{% set filterId = "optionFilter#{random()}" %}
{% set optionListsId = "optionLists#{random()}" %}

{{ forms.checkboxField({
    label : 'Allow Multiple' | t('section-and-product-type'),
    instructions : 'If checked, the user can select multiple sections, otherwise they can only select one.' | t('section-and-product-type'),
    name : 'multiple',
    checked: field.multiple
}) }}

<hr>

{{ forms.selectField({
    label : 'View Mode' | t('section-and-product-type'),
    instructions : 'How the product types are presented when editing an entry. Choose Dropdown when there are a lot of product types to pick from.' | t('section-and-product-type'),
    id : 'viewMode',
    name : 'viewMode',
    value: field.viewMode,
    options : viewModes
}) }}

<hr>

{{ forms.selectField({
    label : 'Template Value' | t('section-and-product-type'),
    instructions : 'What the field hands back in templates. IDs returns the selected product types IDs, which is what this plugin has always done. Objects returns an object whose all(), ids(), handles() and names() methods give you the product types themselves.' | t('section-and-product-type'),
    id : 'valueType',
    name : 'valueType',
    value: field.valueType,
    options : valueTypes
}) }}

<hr>

{{ forms.checkboxField({
    label : 'Select All Product Types' | t('section-and-product-type'),
    instructions : 'This will allow all product types to be used for selection.' | t('section-and-product-type'),
    name : 'selectAll',
    checked: field.selectAll
}) }}

<hr>

{{ forms.textField({
    id: 'partOfHandle',
    label : 'Select Product Type By Text In Handle' | t('section-and-product-type'),
    instructions : 'This will allow to select all product types by text in handle.' | t('section-and-product-type'),
    name : 'partOfHandle',
    value: partOfHandle,
}) }}

<hr>

{{ forms.textField({
    id: filterId,
    label : 'Filter The Lists Below' | t('section-and-product-type'),
    instructions : 'Narrows the two lists below to the product types whose name or handle contains this text. It only changes what is shown, it is not saved with the field.' | t('section-and-product-type'),
    placeholder: 'Search product types' | t('section-and-product-type'),
}) }}

<div id="{{ optionListsId }}">
    {{ forms.checkboxGroupField({
        label : 'Allowed Product Types' | t('section-and-product-type'),
        instructions : 'The product types that may be chosen for this field.\n **If selected Select All Product Types, all sections are selected**.' | t('section-and-product-type'),
        name : 'allowProductTypes',
        values: allowProductTypes,
        options : productTypeOptions
    }) }}

    <hr>

    {{ forms.checkboxGroupField({
        label : 'Exclude Product Types' | t('section-and-product-type'),
        instructions : 'The product types that will be excluded from the selection for this field.\n **Used when select all is on**.' | t('section-and-product-type'),
        options : productTypeOptions,
        id : 'excluded',
        values: field.excludedProductTypes,
        name : 'excludedProductTypes',
    }) }}
</div>

{% js %}
new Craft.SectionAndProductType.OptionFilter('#{{ filterId|namespaceInputId|e('js') }}', '#{{ optionListsId|namespaceInputId|e('js') }}');
{% endjs %}
